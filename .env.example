

APP_ENV=

HTTP_HOST=
HTTP_PORT=
HTTP_READ_TIMEOUT=
HTTP_WRITE_TIMEOUT=
HTTP_IDLE_TIMEOUT=
HTTP_SHUTDOWN_TIMEOUT=

HEALTH_CHECK_TIMEOUT=

LOG_LEVEL=
HTTP_MAX_BODY_BYTES=

OTP_LENGTH=
OTP_TTL=
OTP_MAX_ATTEMPTS=
OTP_RESEND_COOLDOWN=
# true returns the code as debug_code in /auth/otp/request (testing without SMS; refused in production)
OTP_EXPOSE_CODE=
SMS_PROVIDER=

AUTH_RATE_LIMIT=
AUTH_RATE_WINDOW=

# redis://[:password@]host:port/db, required outside development
REDIS_URL=
REDIS_KEY_PREFIX=

# postgres://user:pass@host:5432/db?sslmode=disable, required outside development
# (apply the schema first: make migrate-up DB_URL=...)
DATABASE_URL=


# at least 32 characters, required outside development
JWT_SECRET=
JWT_ISSUER=
JWT_ACCESS_TTL=

# comma separated phones that get this role on first login
ADMIN_PHONES=
VENDOR_PHONES=

TRUSTED_PROXIES=

# Browser origins allowed to call the API (comma-separated, exact
# scheme://host[:port], no "*"). Empty in development = http://localhost:5173
# (the Vite dev server of the admin panel); empty elsewhere = none.
CORS_ALLOWED_ORIGINS=
