[Unit]
Description=TGTG staging PostgreSQL backup
After=network-online.target

[Service]
Type=oneshot
User=tgtg-backup
Group=tgtg-backup
Environment=DB_BACKUP_ENV=/etc/tgtg/db-backup.env
ExecStart=/opt/tgtg/scripts/db/backup.sh
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/tgtg
