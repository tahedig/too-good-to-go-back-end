# /etc/tgtg/db-backup.env   (chmod 600, owned by the backup user). NO passwords here.
PGHOST=staging-db.internal
PGPORT=5432
PGDATABASE=tgtg_staging          # the ACTIVE staging database (read-only source)
PGUSER=tgtg_backup               # read-only role, see docs/db-backup-restore.md
PGPASSFILE=/etc/tgtg/.pgpass     # chmod 600; holds the password, libpq refuses it if too open
PGSSLMODE=require

BACKUP_DIR=/var/backups/tgtg     # 0700, owned by the backup user, ideally its own volume
RETENTION_DAYS=14
RETENTION_MIN_KEEP=3             # never delete below this many backups
BACKUP_GPG_RECIPIENT=            # set to a GPG key id/email to encrypt at rest (public key only on this host)

# Restore target (may be a different server). Needs CREATEDB, owns no active data.
RESTORE_PGHOST=
RESTORE_PGUSER=tgtg_restore
PROTECTED_DBS="tgtg_staging tgtg_production"
