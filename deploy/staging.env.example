# Use an immutable commit tag. The polling service updates this value.
BACKEND_IMAGE=ghcr.io/tahedig/too-good-to-go-back-end:develop-0000000000000000000000000000000000000000

APP_NETWORK=staging-app
BACKEND_BIND=127.0.0.1
BACKEND_PORT=8081

POSTGRES_USER=app
POSTGRES_PASSWORD=replace-with-a-random-password
POSTGRES_DB=tgtg
DATABASE_URL=postgres://app:replace-with-the-same-postgres-password@db:5432/tgtg?sslmode=disable

REDIS_PASSWORD=replace-with-a-random-password
REDIS_URL=redis://:replace-with-the-same-redis-password@redis:6379/0
REDIS_KEY_PREFIX=tgtg:staging:

APP_ENV=staging
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
LOG_LEVEL=info
HEALTH_CHECK_TIMEOUT=2s

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=too-good-to-go-backend
JWT_ACCESS_TTL=1h

OTP_EXPOSE_CODE=true
SMS_PROVIDER=fake
CORS_ALLOWED_ORIGINS=
TRUSTED_PROXIES=
ADMIN_PHONES=
VENDOR_PHONES=
